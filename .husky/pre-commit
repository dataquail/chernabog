# Runs AGENTS.md's fast checks, not the tests; HUSKY=0 skips them for a work-in-progress commit.
# git points GIT_DIR and GIT_INDEX_FILE at this repository for its hooks, which a check that
# runs git in a repository of its own would act on instead.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
bun run precommit
