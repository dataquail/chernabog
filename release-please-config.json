{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "390af789f5c722d2c089d7976ceec1cc17c06bf6",
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": ["packages/recipes", "packages/sdk"]
    },
    "packages/core": {
      "release-type": "node",
      "package-name": "@chernabog/core",
      "component": "core",
      "release-as": "1.0.0",
      "extra-files": [
        {
          "type": "generic",
          "path": "/src/kernel/core-support.value-object.ts"
        }
      ]
    },
    "packages/sdk": {
      "release-type": "node",
      "package-name": "@chernabog/sdk",
      "component": "sdk"
    },
    "packages/recipes": {
      "release-type": "node",
      "package-name": "@chernabog/recipes",
      "component": "recipes",
      "initial-version": "0.1.0"
    }
  }
}
