#!/usr/bin/env bun
// Stands in for tmux in end-to-end tests: a "session" is a detached process
// group whose pid is kept under FAKE_TMUX_STATE. Records each call in FAKE_TMUX_LOG.
// FAKE_TMUX_MISSING: behave as if tmux were not installed.
// FAKE_TMUX_NO_CLIENT: no tmux client is attached, for switch-client to move.
import { spawn } from 'node:child_process';
import { appendFileSync, existsSync, mkdirSync, openSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const args = process.argv.slice(2);
if (process.env.FAKE_TMUX_MISSING) process.exit(127);
const state = process.env.FAKE_TMUX_STATE ?? join(process.env.TMPDIR ?? '/tmp', 'fake-tmux');
mkdirSync(state, { recursive: true });
if (process.env.FAKE_TMUX_LOG) appendFileSync(process.env.FAKE_TMUX_LOG, `${args.slice(0, 4).join(' ')}\n`);

const flag = (name: string) => args[args.indexOf(name) + 1] ?? '';
const pidFile = (name: string) => join(state, `${name.replace(/^=/, '')}.pid`);

const alive = (name: string) => {
  if (!existsSync(pidFile(name))) return false;
  try {
    process.kill(Number(readFileSync(pidFile(name), 'utf8')), 0);
    return true;
  } catch {
    return false;
  }
};

if (args[0] === '-V') {
  console.log('tmux 9.9-fake');
} else if (args[0] === 'new-session') {
  const name = flag('-s');
  if (alive(name)) {
    console.error(`duplicate session: ${name}`);
    process.exit(1);
  }
  // The command is everything after the last option with a value.
  const command = args.slice(args.indexOf('-c') + 2);
  const out = openSync(join(state, `${name}.out`), 'a');
  const child = spawn(command[0]!, command.slice(1), { cwd: flag('-c'), detached: true, stdio: ['ignore', out, out] });
  writeFileSync(pidFile(name), String(child.pid));
  child.unref();
} else if (args[0] === 'has-session') {
  process.exit(alive(flag('-t')) ? 0 : 1);
} else if (args[0] === 'kill-session') {
  const name = flag('-t');
  if (!alive(name)) {
    console.error(`can't find session: ${name}`);
    process.exit(1);
  }
  process.kill(-Number(readFileSync(pidFile(name), 'utf8')), 'SIGKILL');
  rmSync(pidFile(name));
} else if (args[0] === 'switch-client') {
  if (process.env.FAKE_TMUX_NO_CLIENT) {
    console.error('no current client');
    process.exit(1);
  }
  if (!alive(flag('-t'))) {
    console.error(`can't find session: ${flag('-t')}`);
    process.exit(1);
  }
} else if (args[0] === 'attach-session') {
  process.exit(0);
} else {
  console.error(`fake tmux: unknown command ${args.join(' ')}`);
  process.exit(1);
}
