// Types a recipe package's flows and steps against @chernabog/sdk and effect,
// which the package declares as dev dependencies at the versions it supports,
// with @types/bun, since flows run in chernabog's Bun (in this repo, the
// workspace's). A package of your own can copy this file: `tsc --noEmit` then
// checks it.
{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["flows/**/*.ts", "stages/**/*.ts"]
}
