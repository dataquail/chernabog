{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "src",
    "packages/core/src",
    "packages/sdk/src",
    "packages/sdk/index.ts",
    "scripts",
    "test",
    "templates/.chernabog",
    "packages/recipes"
  ]
}
